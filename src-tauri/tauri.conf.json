{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Database Manager",
  "version": "0.2.1",
  "identifier": "it.database-manager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Database Manager",
        "width": 1480,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Italian"]
      }
    },
    "publisher": "Daniele Gabrovec",
    "copyright": "Copyright © 2026 Daniele Gabrovec. Tutti i diritti riservati.",
    "homepage": "https://github.com/danielegabrovec/Database-Manager",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "legal/LICENSE.txt",
      "../LEGAL.md": "legal/NOTE-LEGALI.md",
      "../PRIVACY.md": "legal/PRIVACY.md",
      "../THIRD-PARTY-NOTICES.md": "legal/THIRD-PARTY-NOTICES.md",
      "../licenses/": "legal/licenses/"
    }
  }
}
